<!DOCTYPE html>
<html lang="th">
<head>
  <base target="_top">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ลงทะเบียน Grow Together</title>
  
  <!-- LINE LIFF SDK -->
  <script src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>

  <style>
    * { box-sizing: border-box; }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #f4f6f9;
      margin: 0;
      padding: 20px;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }
    .container {
      background: #ffffff;
      padding: 25px 30px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
      width: 100%;
      max-width: 450px;
    }
    h2 {
      text-align: center;
      color: #2c3e50;
      margin-bottom: 20px;
      font-size: 24px;
    }
    .status-box {
      padding: 12px;
      margin-bottom: 18px;
      border-radius: 8px;
      font-size: 14px;
      text-align: center;
      font-weight: 500;
      background: #fff3cd;
      color: #856404;
      line-height: 1.6;
      word-break: break-word;
    }
    .debug-box {
      display: none;
      padding: 10px;
      margin-bottom: 15px;
      border-radius: 8px;
      background: #f1f5f9;
      color: #334155;
      font-size: 11px;
      line-height: 1.6;
      white-space: pre-wrap;
      word-break: break-word;
      text-align: left;
    }
    .form-group { margin-bottom: 15px; }
    label {
      display: block;
      margin-bottom: 5px;
      color: #34495e;
      font-weight: 600;
      font-size: 13px;
    }
    input[type="text"],
    input[type="tel"],
    input[type="date"] {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      font-size: 14px;
      background: #f8fafc;
    }
    input:focus {
      border-color: #3498db;
      outline: none;
      background: #ffffff;
    }
    .note {
      font-size: 11px;
      color: #7f8c8d;
      margin-top: 4px;
      line-height: 1.5;
    }
    button {
      width: 100%;
      background: #2ecc71;
      color: white;
      border: none;
      padding: 12px;
      font-size: 16px;
      font-weight: 600;
      border-radius: 6px;
      cursor: pointer;
      margin-top: 10px;
    }
    button:hover { background: #27ae60; }
    button:disabled { background: #95a5a6; cursor: not-allowed; }
    .line-user {
      font-size: 12px;
      color: #64748b;
      text-align: center;
      margin-top: 8px;
      margin-bottom: 15px;
      word-break: break-word;
    }
  </style>
</head>

<body>

<div class="container">
  <h2>ลงทะเบียน Grow Together</h2>

  <div id="lineStatus" class="status-box">กำลังเชื่อมต่อ LINE...</div>
  <div id="debugBox" class="debug-box"></div>
  <div id="lineUser" class="line-user"></div>

  <form id="myForm" onsubmit="handleFormSubmit(event)">
    <input type="hidden" id="displayName">
    <input type="hidden" id="pictureUrl">

    <div class="form-group">
      <label for="idOrHN">เลขประจำตัวประชาชน / HN</label>
      <input type="text" id="idOrHN" required placeholder="กรอกเลขบัตร 13 หลัก หรือ HN" autocomplete="off">
    </div>

    <div class="form-group">
      <label for="fullName">ชื่อ - นามสกุล</label>
      <input type="text" id="fullName" required placeholder="ชื่อและนามสกุลจริง" autocomplete="name">
    </div>

    <div class="form-group">
      <label for="phone">เบอร์โทรศัพท์</label>
      <input type="tel" id="phone" required placeholder="0xxxxxxxxx" autocomplete="tel">
    </div>

    <div class="form-group">
      <label for="lmpDate">วันที่ประจำเดือนมาวันแรก (LMP)</label>
      <input type="date" id="lmpDate">
      <div class="note">กรณีตั้งครรภ์ ใช้สำหรับสร้างตารางนัดตรวจครรภ์</div>
    </div>

    <div class="form-group">
      <label for="childBirthDate">วันเกิดบุตร</label>
      <input type="date" id="childBirthDate">
      <div class="note">กรณีคลอดแล้ว ใช้สำหรับสร้างตารางนัดตามช่วงวัย</div>
    </div>

    <button type="submit" id="submitBtn" disabled>กำลังเชื่อมต่อ LINE...</button>
  </form>
</div>

<script>
// ======================================================
// CONFIG (ใส่ URL ของ Apps Script ที่ได้จากการ Deploy ตรงนี้)
// ======================================================
const GAS_URL = "https://script.google.com/macros/s/AKfycbw40ckbOUJ01sn9RFqVxduWeZVUId595Izc4fb2rzQBXccKAxDjdtF36-cMA8b6nS8r/exec"; 
const MY_LIFF_ID = "2011515286-dBBILHX5";

const lineStatusDiv = document.getElementById("lineStatus");
const lineUserDiv = document.getElementById("lineUser");
const debugBox = document.getElementById("debugBox");
const submitBtn = document.getElementById("submitBtn");

let lineIdToken = "";
let liffInitialized = false;

function showDebug(message) {
  console.log("[Grow Together]", message);
  debugBox.style.display = "block";
  debugBox.textContent = message;
}

function setStatus(message, background, color) {
  lineStatusDiv.innerHTML = message;
  if (background) lineStatusDiv.style.backgroundColor = background;
  if (color) lineStatusDiv.style.color = color;
}

async function initLIFF() {
  try {
    showDebug("STEP 1: ตรวจสอบ LIFF SDK...");
    if (typeof liff === "undefined") {
      throw new Error("ไม่พบ LIFF SDK");
    }

    showDebug("STEP 2: กำลังเรียก liff.init()");
    await liff.init({
      liffId: MY_LIFF_ID,
      withLoginOnExternalBrowser: true
    });

    liffInitialized = true;
    showDebug("STEP 3: liff.init() สำเร็จ");

    if (!liff.isLoggedIn()) {
      if (liff.isInClient()) {
        throw new Error("LIFF_INIT_OK_BUT_NOT_LOGGED_IN");
      }
      setStatus("กำลังเข้าสู่ระบบ LINE...", "#fff3cd", "#856404");
      submitBtn.disabled = true;
      return;
    }

    showDebug("STEP 6: กำลังขอ LINE ID Token...");
    lineIdToken = liff.getIDToken();
    if (!lineIdToken) {
      throw new Error("ไม่สามารถรับ LINE ID Token ได้");
    }

    let profile = { displayName: "ผู้ใช้ LINE", pictureUrl: "" };
    try {
      profile = await liff.getProfile();
    } catch (e) {
      console.warn("getProfile warning:", e);
    }

    document.getElementById("displayName").value = profile.displayName || "";
    document.getElementById("pictureUrl").value = profile.pictureUrl || "";

    setStatus(
      "✓ เชื่อมต่อ LINE สำเร็จ<br>ผู้ใช้: " + escapeHtml(profile.displayName || "ผู้ใช้ LINE"),
      "#e8f8f5",
      "#27ae60"
    );

    lineUserDiv.innerText = "LINE เชื่อมต่อพร้อมสำหรับการลงทะเบียน";
    submitBtn.disabled = false;
    submitBtn.innerText = "ลงทะเบียน";

  } catch (error) {
    console.error("LIFF ERROR:", error);
    setStatus("⚠️ ไม่สามารถเชื่อมต่อ LINE ได้<br>กรุณาตรวจสอบรายละเอียดด้านล่าง", "#fdebd0", "#d35400");
    submitBtn.disabled = true;
    submitBtn.innerText = "ไม่สามารถลงทะเบียนได้";
    showDebug("❌ LIFF ERROR\n\n" + (error.message || error));
  }
}

async function handleFormSubmit(event) {
  event.preventDefault();

  if (!liffInitialized) {
    alert("ระบบ LINE ยังเชื่อมต่อไม่สำเร็จ");
    return;
  }
  if (!lineIdToken) {
    alert("ไม่พบ LINE ID Token\n\nกรุณาปิดหน้านี้ แล้วเปิดระบบผ่าน LINE OA อีกครั้ง");
    return;
  }

  const idOrHN = document.getElementById("idOrHN").value.trim();
  const fullName = document.getElementById("fullName").value.trim();
  const phone = document.getElementById("phone").value.trim();
  const lmpDate = document.getElementById("lmpDate").value;
  const childBirthDate = document.getElementById("childBirthDate").value;

  if (!idOrHN || !fullName || !phone) {
    alert("กรุณากรอกข้อมูลให้ครบถ้วน");
    return;
  }

  submitBtn.disabled = true;
  submitBtn.innerText = "กำลังบันทึกข้อมูล...";
  setStatus("กำลังบันทึกข้อมูลลงระบบ...", "#eaf2f8", "#2874a6");

  const formObject = {
    idToken: lineIdToken,
    displayName: document.getElementById("displayName").value,
    pictureUrl: document.getElementById("pictureUrl").value,
    idOrHN: idOrHN,
    fullName: fullName,
    phone: phone,
    lmpDate: lmpDate,
    childBirthDate: childBirthDate
  };

  try {
    const response = await fetch(GAS_URL, {
      method: "POST",
      body: JSON.stringify(formObject),
      headers: {
        "Content-Type": "text/plain;charset=utf-8"
      }
    });

    const result = await response.json();

    if (result && result.success) {
      setStatus("✓ ลงทะเบียนสำเร็จ", "#e8f8f5", "#27ae60");
      alert(result.message || "ลงทะเบียนสำเร็จ");

      document.getElementById("idOrHN").value = "";
      document.getElementById("fullName").value = "";
      document.getElementById("phone").value = "";
      document.getElementById("lmpDate").value = "";
      document.getElementById("childBirthDate").value = "";
    } else {
      throw new Error(result && result.message ? result.message : "ไม่ทราบสาเหตุ");
    }

  } catch (error) {
    console.error("Fetch ERROR:", error);
    setStatus("⚠️ การบันทึกข้อมูลล้มเหลว", "#fdebd0", "#d35400");
    alert("เกิดข้อผิดพลาด:\n\n" + error.message);
  } finally {
    submitBtn.disabled = false;
    submitBtn.innerText = "ลงทะเบียน";
  }
}

function escapeHtml(text) {
  const div = document.createElement("div");
  div.textContent = text;
  return div.innerHTML;
}

if (document.readyState === "loading") {
  document.addEventListener("DOMContentLoaded", initLIFF);
} else {
  initLIFF();
}
</script>

</body>
</html>
